NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=*

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://app:app@localhost:5432/deployforgedb

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# SMTP — points at Mailpit from docker-compose.yml.
# Everything sent lands in the Mailpit UI at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com
MAIL_TO=admin@example.com

